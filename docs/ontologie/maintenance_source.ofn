AnnotationAssertion(rdfs:comment :RapportMaintenance "Document fictif relatant un incident et les actions effectuées."@fr)
Declaration(Class(:Technicien))
AnnotationAssertion(rdfs:label :Technicien "Technicien")
AnnotationAssertion(rdfs:comment :Technicien "Personne fictive ayant effectué une action."@fr)
Declaration(Class(:Competence))
AnnotationAssertion(rdfs:label :Competence "Competence")
AnnotationAssertion(rdfs:comment :Competence "Qualification nommée et partageable entre plusieurs techniciens et actions."@fr)
