Prefix(:=<https://example.org/td-maintenance#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Ontology(<https://example.org/td-maintenance>
Annotation(rdfs:comment "Projet pédagogique. Parc et événements entièrement fictifs. Instantané au 23/09/2026. Modèle OWL 2 DL sans imports distants. Les définitions et limites sont documentées dans le dossier associé."@fr)
Declaration(Class(:ObjetMateriel))
AnnotationAssertion(rdfs:label :ObjetMateriel "ObjetMateriel")
AnnotationAssertion(rdfs:comment :ObjetMateriel "Objet physique identifié, à distinguer des événements, observations, personnes et documents."@fr)
Declaration(Class(:Equipement))
SubClassOf(:Equipement :ObjetMateriel)
AnnotationAssertion(rdfs:label :Equipement "Equipement")
AnnotationAssertion(rdfs:comment :Equipement "Unité de maintenance du parc étudié. Le TD distingue pompe, moteur et compresseur comme unités séparées."@fr)
Declaration(Class(:Pompe))
SubClassOf(:Pompe :Equipement)
AnnotationAssertion(rdfs:label :Pompe "Pompe")
AnnotationAssertion(rdfs:comment :Pompe "Unité de pompage du parc fictif ; ne désigne pas un groupe motopompe complet."@fr)
Declaration(Class(:Moteur))
SubClassOf(:Moteur :Equipement)
AnnotationAssertion(rdfs:label :Moteur "Moteur")
AnnotationAssertion(rdfs:comment :Moteur "Moteur électrique suivi comme une unité séparée."@fr)
Declaration(Class(:Compresseur))
SubClassOf(:Compresseur :Equipement)
AnnotationAssertion(rdfs:label :Compresseur "Compresseur")
AnnotationAssertion(rdfs:comment :Compresseur "Unité de compression du parc fictif."@fr)
Declaration(Class(:Composant))
SubClassOf(:Composant :ObjetMateriel)
AnnotationAssertion(rdfs:label :Composant "Composant")
AnnotationAssertion(rdfs:comment :Composant "Pièce ou sous-ensemble physique appartenant à une unité de maintenance dans cet instantané."@fr)
Declaration(Class(:Roulement))
SubClassOf(:Roulement :Composant)
AnnotationAssertion(rdfs:label :Roulement "Roulement")
AnnotationAssertion(rdfs:comment :Roulement "Roulement physique identifié. Deux machines ont des roulements distincts."@fr)
Declaration(Class(:Rotor))
SubClassOf(:Rotor :Composant)
AnnotationAssertion(rdfs:label :Rotor "Rotor")
AnnotationAssertion(rdfs:comment :Rotor "Rotor physique identifié."@fr)
