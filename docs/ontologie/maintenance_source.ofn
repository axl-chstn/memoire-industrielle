AnnotationAssertion(rdfs:label :SousEnsemble "SousEnsemble")
AnnotationAssertion(rdfs:comment :SousEnsemble "Assemblage physique permettant de représenter un niveau intermédiaire de composition."@fr)
Declaration(Class(:Incident))
AnnotationAssertion(rdfs:label :Incident "Incident")
AnnotationAssertion(rdfs:comment :Incident "Épisode de maintenance documenté dans un instantané daté ; ce n’est ni une machine ni une intervention."@fr)
Declaration(Class(:Symptome))
AnnotationAssertion(rdfs:label :Symptome "Symptome")
