AnnotationAssertion(rdfs:label :NiveauCriticite "NiveauCriticite")
AnnotationAssertion(rdfs:comment :NiveauCriticite "Valeur d’évaluation déclarée dans ce TD ; aucun calcul automatique de risque."@fr)
