    <!-- https://example.org/td-maintenance#Intervention -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Intervention">
        <rdfs:comment xml:lang="fr">Action élémentaire effectuée. Une inspection n’implique pas une résolution.</rdfs:comment>
        <rdfs:label>Intervention</rdfs:label>
    </owl:Class>
    


