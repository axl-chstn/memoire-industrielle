        <rdfs:label>ModeDefaillance</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#Moteur -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Moteur">
        <rdfs:subClassOf rdf:resource="https://example.org/td-maintenance#Equipement"/>
        <rdfs:comment xml:lang="fr">Moteur électrique suivi comme une unité séparée.</rdfs:comment>
        <rdfs:label>Moteur</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#NiveauCriticite -->

    <owl:Class rdf:about="https://example.org/td-maintenance#NiveauCriticite">
        <owl:equivalentClass>
            <owl:Class>
                <owl:oneOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Critique"/>
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Elevee"/>
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Faible"/>
                </owl:oneOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="fr">Valeur d’évaluation déclarée dans ce TD ; aucun calcul automatique de risque.</rdfs:comment>
        <rdfs:label>NiveauCriticite</rdfs:label>
    </owl:Class>
    


