    <owl:Class rdf:about="https://example.org/td-maintenance#ObjetMateriel">
        <rdfs:comment xml:lang="fr">Objet physique identifié, à distinguer des événements, observations, personnes et documents.</rdfs:comment>
        <rdfs:label>ObjetMateriel</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#Pompe -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Pompe">
        <rdfs:subClassOf rdf:resource="https://example.org/td-maintenance#Equipement"/>
