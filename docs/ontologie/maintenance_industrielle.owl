<?xml version="1.0"?>
<rdf:RDF xmlns="https://example.org/td-maintenance#"
     xml:base="https://example.org/td-maintenance"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:td-maintenance="https://example.org/td-maintenance#">
    <owl:Ontology rdf:about="https://example.org/td-maintenance">
        <rdfs:comment xml:lang="fr">Projet pédagogique. Parc et événements entièrement fictifs. Instantané au 23/09/2026. Modèle OWL 2 DL sans imports distants. Les définitions et limites sont documentées dans le dossier associé.</rdfs:comment>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/td-maintenance#aCriticite -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#aCriticite">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#NiveauCriticite"/>
        <rdfs:comment xml:lang="fr">Niveau explicitement attribué dans le scénario fictif.</rdfs:comment>
        <rdfs:label>aCriticite</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#aModeDefaillance -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#aModeDefaillance">
        <owl:inverseOf rdf:resource="https://example.org/td-maintenance#estModeDe"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#ModeDefaillance"/>
        <rdfs:comment xml:lang="fr">Défaillance retenue après examen ; n’est pas déduite automatiquement d’un symptôme.</rdfs:comment>
        <rdfs:label>aModeDefaillance</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#aSymptome -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#aSymptome">
        <owl:inverseOf rdf:resource="https://example.org/td-maintenance#estSymptomeDe"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Symptome"/>
        <rdfs:comment xml:lang="fr">Observation associée à l’incident.</rdfs:comment>
        <rdfs:label>aSymptome</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#affecteObjet -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#affecteObjet">
        <owl:inverseOf rdf:resource="https://example.org/td-maintenance#subitIncident"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://example.org/td-maintenance#concerneComposantPrincipal"/>
            <rdf:Description rdf:about="https://example.org/td-maintenance#faitPartieDe"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="fr">Objet physiquement concerné par l’incident, composant ou assemblage parent ; ne signifie pas panne de tous ses composants.</rdfs:comment>
        <rdfs:label>affecteObjet</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#concerneComposantPrincipal -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#concerneComposantPrincipal">
        <rdfs:subPropertyOf rdf:resource="https://example.org/td-maintenance#affecteObjet"/>
        <owl:inverseOf rdf:resource="https://example.org/td-maintenance#estComposantPrincipalDe"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Composant"/>
        <rdfs:comment xml:lang="fr">Un seul composant principal par fiche incident ; périmètre choisi pour le TD.</rdfs:comment>
        <rdfs:label>concerneComposantPrincipal</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#concerneIncident -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#concerneIncident">
        <owl:inverseOf rdf:resource="https://example.org/td-maintenance#recoitIntervention"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Intervention"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:comment xml:lang="fr">Lien d’une action réalisée vers l’incident concerné.</rdfs:comment>
        <rdfs:label>concerneIncident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#contient -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#contient">
        <owl:inverseOf rdf:resource="https://example.org/td-maintenance#faitPartieDe"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <rdfs:comment xml:lang="fr">Composition physique directe ou indirecte, transitive.</rdfs:comment>
        <rdfs:label>contient</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#contientDirectement -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#contientDirectement">
        <rdfs:subPropertyOf rdf:resource="https://example.org/td-maintenance#contient"/>
        <owl:inverseOf rdf:resource="https://example.org/td-maintenance#faitDirectementPartieDe"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <rdfs:comment xml:lang="fr">Composition immédiate dans l’instantané. Relation simple, sans transitivité.</rdfs:comment>
        <rdfs:label>contientDirectement</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#documente -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#documente">
        <owl:inverseOf rdf:resource="https://example.org/td-maintenance#estDocumentePar"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#RapportMaintenance"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:comment xml:lang="fr">Incident décrit par un document.</rdfs:comment>
        <rdfs:label>documente</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#effectue -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#effectue">
        <owl:inverseOf rdf:resource="https://example.org/td-maintenance#effectueePar"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Technicien"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Intervention"/>
        <rdfs:comment xml:lang="fr">Relation inverse de effectueePar</rdfs:comment>
        <rdfs:label>effectue</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#effectueePar -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#effectueePar">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Intervention"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Technicien"/>
        <rdfs:comment xml:lang="fr">Exécutant de l’action effectuée.</rdfs:comment>
        <rdfs:label>effectueePar</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#estComposantPrincipalDe -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#estComposantPrincipalDe">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Composant"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:comment xml:lang="fr">Relation inverse de concerneComposantPrincipal</rdfs:comment>
        <rdfs:label>estComposantPrincipalDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#estDocumentePar -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#estDocumentePar">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#RapportMaintenance"/>
        <rdfs:comment xml:lang="fr">Relation inverse de documente</rdfs:comment>
        <rdfs:label>estDocumentePar</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#estModeDe -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#estModeDe">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#ModeDefaillance"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:comment xml:lang="fr">Relation inverse de aModeDefaillance</rdfs:comment>
        <rdfs:label>estModeDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#estResoluPar -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#estResoluPar">
        <rdfs:subPropertyOf rdf:resource="https://example.org/td-maintenance#recoitIntervention"/>
        <owl:inverseOf rdf:resource="https://example.org/td-maintenance#resout"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Intervention"/>
        <rdfs:comment xml:lang="fr">Relation inverse de resout</rdfs:comment>
        <rdfs:label>estResoluPar</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#estSymptomeDe -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#estSymptomeDe">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Symptome"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:comment xml:lang="fr">Relation inverse de aSymptome</rdfs:comment>
        <rdfs:label>estSymptomeDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#faitDirectementPartieDe -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#faitDirectementPartieDe">
        <rdfs:subPropertyOf rdf:resource="https://example.org/td-maintenance#faitPartieDe"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <rdfs:comment xml:lang="fr">Relation inverse de contientDirectement</rdfs:comment>
        <rdfs:label>faitDirectementPartieDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#faitPartieDe -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#faitPartieDe">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <rdfs:comment xml:lang="fr">Relation inverse de contient</rdfs:comment>
        <rdfs:label>faitPartieDe</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#porteSur -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#porteSur">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Intervention"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Composant"/>
        <rdfs:comment xml:lang="fr">Composant objet de l’action effectuée.</rdfs:comment>
        <rdfs:label>porteSur</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#possedeCompetence -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#possedeCompetence">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Technicien"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Competence"/>
        <rdfs:comment xml:lang="fr">Compétence déclarée d’un technicien.</rdfs:comment>
        <rdfs:label>possedeCompetence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#recoitIntervention -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#recoitIntervention">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Intervention"/>
        <rdfs:comment xml:lang="fr">Relation inverse de concerneIncident</rdfs:comment>
        <rdfs:label>recoitIntervention</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#requiertCompetence -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#requiertCompetence">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Intervention"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Competence"/>
        <rdfs:comment xml:lang="fr">Compétence requise dans le scénario.</rdfs:comment>
        <rdfs:label>requiertCompetence</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#resout -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#resout">
        <rdfs:subPropertyOf rdf:resource="https://example.org/td-maintenance#concerneIncident"/>
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Intervention"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:comment xml:lang="fr">Résolution déclarée et confirmée dans le scénario ; sous-relation de concerneIncident.</rdfs:comment>
        <rdfs:label>resout</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/td-maintenance#subitIncident -->

    <owl:ObjectProperty rdf:about="https://example.org/td-maintenance#subitIncident">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <rdfs:range rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:comment xml:lang="fr">Relation inverse de affecteObjet</rdfs:comment>
        <rdfs:label>subitIncident</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/td-maintenance#dateConstat -->

    <owl:DatatypeProperty rdf:about="https://example.org/td-maintenance#dateConstat">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Incident"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="fr">Date du constat, scénario fictif de septembre 2026.</rdfs:comment>
        <rdfs:label>dateConstat</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/td-maintenance#dureeMinutes -->

    <owl:DatatypeProperty rdf:about="https://example.org/td-maintenance#dureeMinutes">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#Intervention"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#nonNegativeInteger"/>
        <rdfs:comment xml:lang="fr">Durée de l’action fictive, en minutes.</rdfs:comment>
        <rdfs:label>dureeMinutes</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://example.org/td-maintenance#resumeRapport -->

    <owl:DatatypeProperty rdf:about="https://example.org/td-maintenance#resumeRapport">
        <rdfs:domain rdf:resource="https://example.org/td-maintenance#RapportMaintenance"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="fr">Texte source synthétique, créé pour le TD.</rdfs:comment>
        <rdfs:label>resumeRapport</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/td-maintenance#Bruit -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Bruit">
        <rdfs:subClassOf rdf:resource="https://example.org/td-maintenance#Symptome"/>
        <rdfs:comment xml:lang="fr">Observation d’un bruit signalé comme anormal.</rdfs:comment>
        <rdfs:label>Bruit</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#Capteur -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Capteur">
        <rdfs:subClassOf rdf:resource="https://example.org/td-maintenance#Composant"/>
        <rdfs:comment xml:lang="fr">Capteur physique identifié.</rdfs:comment>
        <rdfs:label>Capteur</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#Competence -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Competence">
        <rdfs:comment xml:lang="fr">Qualification nommée et partageable entre plusieurs techniciens et actions.</rdfs:comment>
        <rdfs:label>Competence</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#Composant -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Composant">
        <rdfs:subClassOf rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <owl:disjointWith rdf:resource="https://example.org/td-maintenance#Equipement"/>
        <rdfs:comment xml:lang="fr">Pièce ou sous-ensemble physique appartenant à une unité de maintenance dans cet instantané.</rdfs:comment>
        <rdfs:label>Composant</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#Compresseur -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Compresseur">
        <rdfs:subClassOf rdf:resource="https://example.org/td-maintenance#Equipement"/>
        <rdfs:comment xml:lang="fr">Unité de compression du parc fictif.</rdfs:comment>
        <rdfs:label>Compresseur</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#Desalignement -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Desalignement">
        <rdfs:subClassOf rdf:resource="https://example.org/td-maintenance#ModeDefaillance"/>
        <rdfs:comment xml:lang="fr">Occurrence de désalignement retenue après examen dans le scénario.</rdfs:comment>
        <rdfs:label>Desalignement</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#Equipement -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Equipement">
        <rdfs:subClassOf rdf:resource="https://example.org/td-maintenance#ObjetMateriel"/>
        <rdfs:comment xml:lang="fr">Unité de maintenance du parc étudié. Le TD distingue pompe, moteur et compresseur comme unités séparées.</rdfs:comment>
        <rdfs:label>Equipement</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#EquipementAvecRoulement -->

    <owl:Class rdf:about="https://example.org/td-maintenance#EquipementAvecRoulement">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Equipement"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/td-maintenance#contient"/>
                        <owl:someValuesFrom rdf:resource="https://example.org/td-maintenance#Roulement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="fr">Équipement contenant au moins un roulement, directement ou indirectement.</rdfs:comment>
        <rdfs:label>EquipementAvecRoulement</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#EquipementDeuxRoulementsDirects -->

    <owl:Class rdf:about="https://example.org/td-maintenance#EquipementDeuxRoulementsDirects">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Equipement"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/td-maintenance#contientDirectement"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://example.org/td-maintenance#Roulement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="fr">Équipement ayant au moins deux roulements directs distincts.</rdfs:comment>
        <rdfs:label>EquipementDeuxRoulementsDirects</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#Fuite -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Fuite">
        <rdfs:subClassOf rdf:resource="https://example.org/td-maintenance#Symptome"/>
        <rdfs:comment xml:lang="fr">Observation d’une fuite.</rdfs:comment>
        <rdfs:label>Fuite</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#Incident -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Incident">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/td-maintenance#aCriticite"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://example.org/td-maintenance#NiveauCriticite"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/td-maintenance#concerneComposantPrincipal"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://example.org/td-maintenance#Composant"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="fr">Épisode de maintenance documenté dans un instantané daté ; ce n’est ni une machine ni une intervention.</rdfs:comment>
        <rdfs:label>Incident</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#IncidentCritique -->

    <owl:Class rdf:about="https://example.org/td-maintenance#IncidentCritique">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Incident"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/td-maintenance#aCriticite"/>
                        <owl:hasValue rdf:resource="https://example.org/td-maintenance#Critique"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="fr">Incident avec criticité déclarée Critique.</rdfs:comment>
        <rdfs:label>IncidentCritique</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#IncidentNonResolu -->

    <owl:Class rdf:about="https://example.org/td-maintenance#IncidentNonResolu">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Incident"/>
                    <owl:Class>
                        <owl:complementOf>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://example.org/td-maintenance#estResoluPar"/>
                                <owl:someValuesFrom rdf:resource="https://example.org/td-maintenance#Intervention"/>
                            </owl:Restriction>
                        </owl:complementOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="fr">Incident explicitement sans intervention résolutive dans cet instantané ; absence de lien seule insuffisante.</rdfs:comment>
        <rdfs:label>IncidentNonResolu</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#IncidentPompe -->

    <owl:Class rdf:about="https://example.org/td-maintenance#IncidentPompe">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Incident"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/td-maintenance#affecteObjet"/>
                        <owl:someValuesFrom rdf:resource="https://example.org/td-maintenance#Pompe"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="fr">Incident affectant une pompe, y compris par inférence de composition.</rdfs:comment>
        <rdfs:label>IncidentPompe</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#IncidentResolu -->

    <owl:Class rdf:about="https://example.org/td-maintenance#IncidentResolu">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Incident"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/td-maintenance#estResoluPar"/>
                        <owl:someValuesFrom rdf:resource="https://example.org/td-maintenance#Intervention"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="fr">Incident pour lequel une intervention ayant résolu l’épisode est connue ou logiquement impliquée.</rdfs:comment>
        <rdfs:label>IncidentResolu</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#IncidentRoulement -->

    <owl:Class rdf:about="https://example.org/td-maintenance#IncidentRoulement">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Incident"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/td-maintenance#concerneComposantPrincipal"/>
                        <owl:someValuesFrom rdf:resource="https://example.org/td-maintenance#Roulement"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="fr">Incident dont le composant principal est un roulement.</rdfs:comment>
        <rdfs:label>IncidentRoulement</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#IncidentSymptomesVibroAcoustiques -->

    <owl:Class rdf:about="https://example.org/td-maintenance#IncidentSymptomesVibroAcoustiques">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Incident"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/td-maintenance#aSymptome"/>
                        <owl:someValuesFrom rdf:resource="https://example.org/td-maintenance#Symptome"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/td-maintenance#aSymptome"/>
                        <owl:allValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://example.org/td-maintenance#Bruit"/>
                                    <rdf:Description rdf:about="https://example.org/td-maintenance#Vibration"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:allValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="fr">Incident ayant au moins un symptôme et uniquement des vibrations ou des bruits. Ne définit pas sa cause.</rdfs:comment>
        <rdfs:label>IncidentSymptomesVibroAcoustiques</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#IncidentVibrationSeule -->

    <owl:Class rdf:about="https://example.org/td-maintenance#IncidentVibrationSeule">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/td-maintenance#Incident"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/td-maintenance#aSymptome"/>
                        <owl:someValuesFrom rdf:resource="https://example.org/td-maintenance#Vibration"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/td-maintenance#aSymptome"/>
                        <owl:allValuesFrom rdf:resource="https://example.org/td-maintenance#Vibration"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="fr">Incident dont les symptômes sont exclusivement des vibrations, avec au moins une observation.</rdfs:comment>
        <rdfs:label>IncidentVibrationSeule</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/td-maintenance#Inspection -->

    <owl:Class rdf:about="https://example.org/td-maintenance#Inspection">
        <rdfs:subClassOf rdf:resource="https://example.org/td-maintenance#Intervention"/>
        <rdfs:comment xml:lang="fr">Action élémentaire d’examen ou de diagnostic.</rdfs:comment>
